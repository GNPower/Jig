<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<!--
  Test fixture: a hardware handoff in the layout Vivado writes, written by hand
  for Jig's tests. Block design example_bd on a 7z020:

  - the PS's two general-purpose masters: GP0 through an AXI Interconnect to
    an AXI GPIO, an AXI Timer (no model in Jig), an AXI Quad SPI, the CDMA's
    registers and an exported AXI port, user_axi; GP1 through a SmartConnect
    to a BRAM controller;
  - an AXI CDMA whose own map reaches the PS's HP0 port (DDR and the high
    OCM) and the BRAM;
  - two reset blocks: proc_sys_reset_0 from FCLK_RESET0_N for GP0's slaves,
    proc_sys_reset_1 from FCLK_RESET1_N for GP1's; the timer's reset comes
    straight from FCLK_RESET0_N;
  - the AXI GPIO's channel 1 inputs from xlconcat_1: FCLK_RESET1_N,
    proc_sys_reset_1's peripheral_aresetn, a constant 1, proc_sys_reset_0's
    peripheral_aresetn and the design's switches[3:0]; channel 2 drives leds;
  - the Quad SPI's ext_spi_clk on FCLK_CLK0, C_SCK_RATIO 16;
  - IRQ_F2P[10:0] from xlconcat_0's ten inputs: In0 the Quad SPI, In1 the
    timer, In2 the design's fabric_irq[1:0], In3 a constant 0, In5 the CDMA,
    In7 the design's user_irq, In8 the GPIO; In4, In6 and In9 are open.
-->
<EDKSYSTEM EDWVERSION="1.2" TIMESTAMP="Mon Oct 19 12:00:00 2026" VIVADOVERSION="2024.1">

  <SYSTEMINFO ARCH="zynq" DEVICE="7z020" NAME="example_bd" PACKAGE="clg484" SPEEDGRADE="-1"/>

