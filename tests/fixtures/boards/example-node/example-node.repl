// The example-node fixture's board description, loaded after the Zynq-7000
// platform (soc_platform). The unit tests read it; they do not load it into
// Renode. Without a ps7_init, the clock frequencies are stated here.

globalTimer:
    frequency: 333333333

privateTimer:
    frequency: 333333333

swdt:
    frequency: 111111111

uart0:
    clockFrequency: 50000000

uart1:
    clockFrequency: 50000000
