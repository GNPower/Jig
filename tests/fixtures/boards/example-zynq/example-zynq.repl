// Clock properties of the example-zynq fixture, as a board file sets them
// after including the Zynq-7000 platform. The unit tests read this file; they
// do not load it into Renode.

globalTimer:
    frequency: 325000000

uart1:
    clockFrequency: 50000000 // UART_CLK_CTRL: IO PLL / 20

can0:
    referenceClockFrequency: 100000000

qspi:
    referenceClockFrequency: 200000000
