// SPDX-License-Identifier: MIT
// Copyright (c) 2026 Graham Power
//
// Digilent ZedBoard: a Xilinx Zynq-7020 with 512 MB of DDR3, clocked by a
// 33.333 MHz PS_CLK oscillator (Digilent ZedBoard Hardware User's Guide), on
// Jig's Zynq-7000 processing system.
//
// Clocks are the ones the example firmware programs from that PS_CLK, the plan
// of UG585 Table 25-3 example 1: CPU_6x4x 666.67 MHz, so CPU_3x2x (private and
// global timers) 333.33 MHz and CPU_1x (TTC, SWDT) 111.11 MHz; UART_REF_CLK
// 50 MHz; CAN_REF_CLK 100 MHz.
//
// Boot-mode straps: JTAG, PLLs enabled. The firmware is loaded with LoadELF, as
// a debugger would load it after running the board's ps7_init.
//
// The file changes and adds to Jig's Zynq-7000 platform, so that platform has
// to be loaded first: Jig loads it for the boards in boards/ (soc_platform:
// xilinx/zynq7000 in their board.yaml), and renode/two-boards.resc loads
// src/jig/platforms/xilinx/zynq7000.repl before this file.

globalTimer:
    frequency: 333333333

privateTimer:
    frequency: 333333333

ttc0:
    frequency: 111111111

ttc1:
    frequency: 111111111

swdt:
    frequency: 111111111

uart0:
    clockFrequency: 50000000

uart1:
    clockFrequency: 50000000

can0:
    referenceClockFrequency: 100000000

can1:
    referenceClockFrequency: 100000000

slcr:
    bootMode: 0

// DDR from 0x00100000, the first address every master sees as DDR (UG585
// Table 4-1), to the end of the 512 MB; the low OCM covers 0x0 to 0x2FFFF.
ddr: Memory.MappedMemory @ sysbus 0x00100000
    size: 0x1FF00000
