// Renode entry point for the Verilated top @TOP@, in library mode.
// Generated by Jig (jig.ext.cosim.build_library); edit the build options,
// not this file.
//
// Renode loads this shared library into its own process (a
// CoSimulatedPeripheral with SimulationFilePathLinux), calls
// initialize_context with the peripheral's SimulationContextLinux string,
// then initialize_native, which calls Init below. The top's AXI4-Lite port
// carries every access to the peripheral, with absolute addresses; its
// interrupt outputs are the peripheral's GPIOs 0, 1, ... in the order the
// build lists them.
//
// The context string holds key=value items separated by semicolons. A model
// that takes options defines
//     extern "C" void jig_cosim_context(const char* key, const char* value);
// in one of the build's extra C++ sources; it receives every item.

#include <string>

#include "V@TOP@.h"
#include "src/buses/axilite.h"
#include "src/renode_bus.h"
#include "verilated.h"

extern "C" __attribute__((weak)) void jig_cosim_context(const char* key, const char* value);

namespace {

VerilatedContext* context = nullptr;
V@TOP@* top = nullptr;
RenodeAgent* agent = nullptr;

void evaluate()
{
    top->eval();
    if (agent != nullptr) {
        agent->handleInterrupts();
    }
}

}  // namespace

extern "C" void initialize_context(const char* text)
{
    if (text == nullptr || jig_cosim_context == nullptr) {
        return;
    }
    std::string rest(text);
    while (!rest.empty()) {
        const size_t end = rest.find(';');
        const std::string item = rest.substr(0, end);
        rest = end == std::string::npos ? std::string() : rest.substr(end + 1);
        const size_t equals = item.find('=');
        if (equals == std::string::npos) {
            continue;
        }
        jig_cosim_context(item.substr(0, equals).c_str(), item.substr(equals + 1).c_str());
    }
}

RenodeAgent* Init()
{
    context = new VerilatedContext;
    top = new V@TOP@{context};

    AxiLite* bus = new AxiLite();
@BINDINGS@
    bus->evaluateModel = &evaluate;

    agent = new RenodeAgent();
    agent->addBus(bus);
@INTERRUPTS@
    agent->connectNative();
    return agent;
}
